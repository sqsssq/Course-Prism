# Copy to .env and replace the secrets before starting.
SECRET_KEY=replace-with-a-long-random-value
MYSQL_PASSWORD=replace-with-a-long-random-value
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-value
HASH_SALT=replace-with-a-long-random-value
SITE_URL=http://localhost:3000

# Registration needs a verified campus email domain and working SMTP credentials.
EMAIL_ACCOUNT_DOMAIN=
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=465
EMAIL_USE_SSL=True
